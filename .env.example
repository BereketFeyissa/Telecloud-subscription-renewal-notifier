# tele_scraper configuration. Copy to .env for local development.
# NEVER commit a filled-in .env (CLAUDE.md §3.2). In the cluster these come from a
# ConfigMap (non-secret) and a Secret (everything marked SECRET).

# --- portal -------------------------------------------------------------------
PORTAL_BASE_URL=https://portal.example.test
# Startup requires ONE authentication method: these credentials, or a borrowed session
# below. Leave these blank when using PORTAL_SESSION_COOKIE for capture/testing.
PORTAL_USERNAME=
# PREFERRED: the portal hashes the password in the browser, so supply that digest and this
# service never handles your real password. Read it from DevTools -> Network -> the login
# request -> Payload -> "password". Re-generate it after any password change.
PORTAL_PASSWORD_HASH=                   # SECRET (password-equivalent - treat as the password)
# Plaintext alternative, hashed locally before sending. The algorithm below is inferred from
# the digest length and is NOT confirmed against the login page - prefer the hash above.
PORTAL_PASSWORD=                        # SECRET
PORTAL_PASSWORD_HASH_ALGO=sha256
# Header carrying the session JWT returned by login (valid ~2h; a fresh one is fetched per run).
PORTAL_TOKEN_HEADER=token
PORTAL_LOGIN_PATH=/api/iam/v1/login
# Borrow a logged-in browser session so you can reach the portal before the real auth flow
# is implemented. Paste the FULL value of the request's "Cookie" header (DevTools -> Network
# -> click the page request -> Request Headers -> Cookie). TESTING ONLY: it expires.
PORTAL_SESSION_COOKIE=                  # SECRET
# Alternative for token-based portals: the full Authorization header value, e.g. "Bearer ey..."
PORTAL_AUTH_HEADER=                     # SECRET
PORTAL_COMPONENTS_PATH=/api/cbp/thirdapi/v1/renewal_service/renewlist
PORTAL_PAGE_SIZE=50
PORTAL_MAX_PAGES=50
# Comma-separated portal strings that mean suspended/blocked/inactive.
# EMPTY BY DEFAULT: while unset, no component is ever classified SUSPENDED.
# Fill this in once the portal's real vocabulary is known (CLAUDE.md §2 open 2).
PORTAL_SUSPENDED_TOKENS=
# Extra CA certificates, ADDED to the default trust store. Needed when the portal serves its
# leaf certificate without the intermediate CA (browsers hide this; Python does not).
# Verification is never disabled - there is no insecure-TLS option by design.
PORTAL_CA_BUNDLE=deploy/base/portal-ca.pem

# --- scraping -----------------------------------------------------------------
SCRAPE_TIMEOUT_SECONDS=30
SCRAPE_DELAY_SECONDS=1.0                # politeness delay between requests
SCRAPE_CONCURRENCY=2
SCRAPE_MAX_ATTEMPTS=3
SCRAPE_USER_AGENT=tele-scraper/0.1 (ops@example.test)
SCRAPE_DEBUG=false                      # true dumps raw HTML to SCRAPE_DEBUG_DIR
SCRAPE_DEBUG_DIR=/tmp/tele-scraper-debug

# --- evaluation ---------------------------------------------------------------
APP_TIMEZONE=Africa/Addis_Ababa         # display only; all storage/compute is UTC
WARN_THRESHOLDS=14d,7d,3d,1d,12h        # warning ladder, each rung fires once
# Our own portal login is watched on a wider ladder: an expired password silences every alert,
# and changing one needs a Secret update and a rollout, so it wants more lead time.
CREDENTIAL_WARN_THRESHOLDS=30d,14d,7d,3d,1d
MONITOR_CREDENTIALS=true
MONITOR_ACCOUNT_EXPIRY=true

# --- scheduling ---------------------------------------------------------------
RUN_INTERVAL_SECONDS=3600
RUN_JITTER_SECONDS=30
RUN_TIMEOUT_SECONDS=900                 # a cycle exceeding this is abandoned

# --- notification -------------------------------------------------------------
NOTIFY_ENABLED=false                    # master switch; false everywhere but production
DRY_RUN=false                           # evaluate and log, send nothing
NOTIFY_TIMEOUT_SECONDS=15
# An unconfirmed alert repeats every run; confirming it is what stops it. A confirmation
# expires after ACK_TTL_DAYS so a forgotten problem resurfaces - it is a snooze, not silence.
REQUIRE_ACKNOWLEDGEMENT=true
# Notice when a component the portal used to list disappears. Silently losing sight of a
# component is the same class of failure as a scraper that silently stops running.
DETECT_MISSING_COMPONENTS=true
ACK_TTL_DAYS=7
# Poll Telegram for Confirm button presses. Long polling: outbound only, no public endpoint.
TELEGRAM_ACK_ENABLED=true
TELEGRAM_POLL_TIMEOUT_SECONDS=25
DEFAULT_LOCALE=en

# Routing: recipients x channels, as data. Use the file form in the cluster.
NOTIFY_ROUTES_FILE=
NOTIFY_ROUTES_JSON={"routes":[{"recipient":"ops-team","channels":[{"channel":"slack","address_env":"SLACK_WEBHOOK_OPS"},{"channel":"email","address":"ops@example.test"}],"statuses":["EXPIRED","EXPIRING_SOON","UNKNOWN","SUSPENDED"],"components":["*"],"locale":"en"}]}

# Webhook URLs are credentials: reference them via "address_env" in the routing
# table and supply the value from a Secret.
SLACK_WEBHOOK_OPS=                      # SECRET
DISCORD_WEBHOOK_OPS=                    # SECRET

SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                          # SECRET
SMTP_FROM=alerts@example.test
# auto = implicit TLS on port 465 (SMTPS), STARTTLS on anything else. They are not
# interchangeable: a STARTTLS client pointed at 465 hangs.
SMTP_TLS=auto

TELEGRAM_BOT_TOKEN=                     # SECRET
TELEGRAM_API_BASE=https://api.telegram.org

# SMS: no provider chosen yet, so routes naming 'sms' will fail on delivery.
# See src/tele_scraper/notify/sms.py for what is needed (CLAUDE.md §2 open 3).

# --- state --------------------------------------------------------------------
STATE_BACKEND=sqlite
# The code default (/var/lib/tele-scraper/state.sqlite3) is where the PVC mounts inside the
# container, and is not writable on a workstation. This local path keeps `make dry-run`
# working straight after `cp .env.example .env`; the manifests override it in the cluster,
# where it MUST be on a PVC and never an emptyDir.
STATE_DSN=state/state.sqlite3
STATE_RETENTION_DAYS=30

# --- observability ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_HOST=0.0.0.0
METRICS_PORT=9100
